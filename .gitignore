# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Editor / IDE backup & swap files ──────────────────────────────────────
*~
*.bak
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db

# ── Blender ────────────────────────────────────────────────────────────────
# Auto-saved blend backups; keep .blend itself if the user commits any.
*.blend1
*.blend2
*.blend3
*.blend@

# ── Local tool workspaces / per-user config ───────────────────────────────
.claude/

# ── Release build output ───────────────────────────────────────────────────
_launch/

# ── Dev-only scratch kept out of version control ───────────────────────────
_archived_presets/
PROGRAM_FUNCTIONS_TECHNICAL_LOG.md

# ── Material presets ────────────────────────────────────────────────────────
# The 13 presets shipped with the product are tracked via the allowlist
# below. Anything else under presets/ is user scratch.
presets/*.tlm
!presets/Anime.tlm
!presets/Bronze\ Verdigris\ Patina.tlm
!presets/Burn\ Dissolve.tlm
!presets/Coral\ Rock.tlm
!presets/Galaxy\ Marble.tlm
!presets/Holo\ Card.tlm
!presets/Inverted\ Checker.tlm
!presets/Mars.tlm
!presets/Mirror.tlm
!presets/Oil\ Slick.tlm
!presets/Plasma\ Core.tlm
!presets/Watercolor.tlm
!presets/Wireframe.tlm
